NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# TEST or LIVE — must match the provider_environment of every price row
# checkout is allowed to use (see lib/billing/dal.ts/lib/billing/actions.ts).
# Defaults to TEST if unset.
PAYSTACK_ENVIRONMENT=TEST

RESEND_API_KEY=

# Phase 1M — interim, single-tenant Meta WhatsApp Cloud API
# configuration. Server-only: never a NEXT_PUBLIC_ variable. Per-business
# encrypted credential onboarding (real Embedded Signup) is a separately
# reviewed future subphase — see lib/whatsapp/config.ts's own header
# comment. Every value below fails closed if unset/malformed.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
# e.g. v21.0
META_GRAPH_API_VERSION=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_DISPLAY_PHONE_NUMBER=
# The ONE BusinessOS business (uuid) this environment's configured
# WABA/phone number may be connected to, in this interim single-tenant
# round.
WHATSAPP_CONTROLLED_BUSINESS_ID=

SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=