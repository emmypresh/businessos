# Copy to .env.test.local and fill in from `supabase status` after `supabase start`.
# Used by tests/integration/* and playwright.config.ts — never by app/ or lib/.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_TEST_SECRET_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# The E2E base URL is NOT read from an env var — playwright.config.ts
# hardcodes it to http://127.0.0.1:3100 (a fixed, dedicated port, not the
# app's normal dev port 3000) on purpose, so it can't be silently blanked
# or mistyped here. See playwright.config.ts and tests/e2e/global-setup.ts.
MAILPIT_URL=http://127.0.0.1:54324
# Both of the following must be set together, AND the exact target URL
# must appear in ALLOWED_CI_TEST_URLS, for tests/integration/helpers to
# accept a non-local Supabase/database URL at all — see url-safety.ts.
# Set only in a CI job that deliberately runs integration tests against a
# disposable, non-local Supabase branch. Leave unset locally.
ALLOW_REMOTE_TEST_SUPABASE=
# Comma-separated exact URLs (Supabase API and/or DATABASE_URL) that are
# allowed when the two flags above are both "true". Naming the disposable
# CI project explicitly — not just "any remote" — is the point.
ALLOWED_CI_TEST_URLS=
